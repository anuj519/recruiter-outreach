HUNTER_API_KEY=         # free plan works; leave empty to use Apollo instead
APOLLO_API_KEY=         # needs a paid Apollo plan
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=   # written by auth_google.py
GOOGLE_REFRESH_TOKEN_UMICH=   # written by auth_google.py umich (optional second sender)
SHEET_ID=               # written by setup_sheet.py
SENDER_NAME=Nathan Done

# Optional overrides (defaults shown)
DRY_RUN=true
AUTO_APPROVE=false      # true = email verified contacts without manual review
DAILY_NEW_LIMIT=20
MAX_FOLLOW_UPS=1
FOLLOW_UP_DAYS=7
SEND_DELAY_SECONDS=30
MAX_ENRICH_PER_RUN=20
MAX_PER_COMPANY=3        # new people per company per pull
